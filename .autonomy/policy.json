{
  "schema_version": 1,
  "protected_exact_paths": [
    "EXPERIMENT_PROTOCOL.md",
    "PRODUCT_GOAL.md",
    "DEFINITION_OF_DONE.md",
    "GOVERNANCE.md",
    "PDSA_PROTOCOL.md",
    "AGENTS.md"
  ],
  "protected_prefixes": [
    ".autonomy/",
    ".github/workflows/",
    "scripts/autonomy/",
    "tests/autonomy/"
  ],
  "historical_prefixes": [
    "cycles/",
    "final-audits/"
  ],
  "rollback_product_changes_on_verification_failure": true,
  "max_plan_revisions": 3,
  "max_ai_calls_per_cycle": 14,
  "max_context_characters": 16000,
  "max_executor_read_files": 12,
  "max_executor_operations": 30,
  "synthetic_data_only": true,
  "forbidden_secret_name_fragments": [
    "TOKEN",
    "SECRET",
    "PASSWORD",
    "API_KEY",
    "PRIVATE_KEY"
  ],
  "minimum_verification": {
    "autonomy_tests": true,
    "product_verification_required_after_product_change": true
  }
}
